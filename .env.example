# Server Configuration (Required)
NODE_PORT=
NODE_NAME=

# Inference Engine Configuration (Required)
# Compatible with llama-server, vLLM, Ollama, etc.
INFERENCE_URL=
INFERENCE_MODEL=
INFERENCE_TIMEOUT_SEC=60

# Token Envelope & Memory Budget (Required)
CONTEXT_LIMIT=2048
OUTPUT_RESERVE=256

# Prompt Budgets (Optional, tokens)
# Each part is a cap; whatever a part leaves unused goes to the sensory chunks.
# The prompt window is CONTEXT_LIMIT - OUTPUT_RESERVE - PROMPT_SAFETY_MARGIN.
GOAL_BUDGET=150
OBSERVATION_BUDGET=572
LONG_TERM_BUDGET=350
# 0 = no cap: sensory gets the rest of the window
SENSORY_BUDGET=0
# Headroom for chat-template tokens and token-estimate error
PROMPT_SAFETY_MARGIN=32

# Optional System Prompt Override
SYSTEM_PROMPT=
