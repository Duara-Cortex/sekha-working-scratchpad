# Server Configuration (Required)
NODE_PORT=
NODE_NAME=

# Inference Engine Configuration (Required)
# Compatible with llama-server, vLLM, Ollama, etc.
INFERENCE_URL=
INFERENCE_MODEL=
INFERENCE_TIMEOUT_SEC=60

# Token Envelope & Memory Budget (Required)
CONTEXT_LIMIT=2048
OUTPUT_RESERVE=256

# Prompt Budgets (Optional, tokens)
# Each part is a cap; whatever a part leaves unused goes to the sensory chunks.
# The prompt window is CONTEXT_LIMIT - OUTPUT_RESERVE - PROMPT_SAFETY_MARGIN.
GOAL_BUDGET=150
OBSERVATION_BUDGET=572
LONG_TERM_BUDGET=350
# 0 = no cap: sensory gets the rest of the window
SENSORY_BUDGET=0
# Headroom for chat-template tokens and token-estimate error
PROMPT_SAFETY_MARGIN=32

# Optional System Prompt Override
SYSTEM_PROMPT=

# Working Memory (Optional)
# Node 3 pushes chunks to POST /api/v1/working/chunks; Node 2 never calls Node 3.
# Per-call prompt budget in tokens (system + user); related items count toward it
WM_CALL_BUDGET=1024
# Longest a strong chunk may wait in the queue before it is committed unprocessed; 0 = no limit
WM_WAIT_LIMIT_SEC=600
# Idle time after the last call before a finished memory is committed
WM_IDLE_TIMEOUT_SEC=60
# Parallel model workers (1 on the Pi 5)
WM_WORKERS=1
# Related items from the same memory (temp DB) offered to one model call; 0 = none
WM_RELATED_ITEMS=5
# Items held across all memories; Node 3 pushes beyond this get 503 and are retried
WM_MAX_ITEMS=50000
# Strength added by one reinforcement
WM_REINFORCE_STEP=0.1
# Longest one commit may take
WM_COMMIT_TIMEOUT_SEC=30
# Interim commit target until Node 1's write endpoint (Task 31): one JSON line per memory.
# Without it, Node 3's pushes are refused (503) so nothing is accepted that could not be committed.
WM_COMMIT_JOURNAL=
# OpenAI-compatible embeddings server for scoring harness items and thoughts against the task
# (all-MiniLM-L6-v2, as on Node 3); empty = stored unscored
WM_EMBED_URL=
WM_EMBED_MODEL=
